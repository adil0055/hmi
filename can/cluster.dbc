CM_ "Instrument cluster (IPC) CAN matrix. Every message is sent cyclically at its GenMsgCycleTime. Messages carrying a _CRC and a _Counter signal are protected AUTOSAR E2E profile 1 style: the counter counts 0..14, and the CRC is CRC-8 SAE J1850 (poly 0x1D, init 0xFF, final XOR 0xFF) over the Data ID (the message ID, low byte then high byte) and data bytes 1..7. The cluster treats a message as lost after 5 cycles without a valid frame (at least 200 ms), and shows the failsafe for it: the ABS, ESC and brake lamps for ESC_01, the airbag lamp for SRS_01, the steering lamp for EPS_01, the engine lamp for ECM_01. Telltale requests (_TtReq) take Off, On, Flash (the cluster flashes the lamp at 1.3 Hz) or SNA (signal not available). BCM_KL15 is the ignition: the cluster boots on KL15 On, shows a 3 s bulb check with every lamp lit and the gauges swept, and goes dark on Off.";
CM_ BO_ 1472 "Sent by the cluster: its display state and odometer.";
CM_ SG_ 160 ESC_VehicleSpeed "Vehicle speed. 0xFFFF: not available, shown as ---.";
CM_ SG_ 160 ESC_ABS_TtReq "ABS warning lamp request.";
CM_ SG_ 160 ESC_ESC_TtReq "ESC lamp request; flashes while ESC intervenes.";
CM_ SG_ 160 ESC_ESCOff_TtReq "ESC off lamp request.";
CM_ SG_ 160 ESC_TCSOff_TtReq "Traction control off lamp request.";
CM_ SG_ 160 ESC_BrakeWarn_TtReq "Brake system warning lamp request.";
CM_ SG_ 160 ESC_EPB_Sts "Electric parking brake: Applied lights the parking brake lamp, Fault flashes it.";
CM_ SG_ 176 ECM_EngineSpeed "Engine speed. 0xFFFF: not available.";
CM_ SG_ 176 ECM_MIL_TtReq "Check engine lamp (MIL) request.";
CM_ SG_ 176 ECM_OilPress_TtReq "Oil pressure warning lamp request.";
CM_ SG_ 176 ECM_Charge_TtReq "Battery charge warning lamp request.";
CM_ SG_ 176 ECM_GlowPlug_TtReq "Glow plug lamp request.";
CM_ SG_ 176 ECM_CoolantWarn_TtReq "Coolant temperature warning lamp request.";
CM_ SG_ 176 ECM_ShiftUp_Req "Shift-up indicator request.";
CM_ SG_ 192 TCU_GearSel "Selected gear.";
CM_ SG_ 192 TCU_GearActual "Gear engaged, shown beside D.";
CM_ SG_ 192 TCU_DriveMode "Drive mode.";
CM_ SG_ 192 TCU_DriverMsg "Driver message request.";
CM_ SG_ 800 SRS_Airbag_TtReq "Airbag warning lamp request.";
CM_ SG_ 800 SRS_BuckleDriver "Driver seat belt buckle. The cluster lights the seat belt lamp when a belt in use is unbuckled, and flashes it above 25 km/h.";
CM_ SG_ 800 SRS_BucklePass "Passenger seat belt buckle; counts only with the seat occupied.";
CM_ SG_ 800 SRS_PassOccupied "Passenger seat occupied.";
CM_ SG_ 816 EPS_Warn_TtReq "Power steering warning lamp request.";
CM_ SG_ 832 ADAS_CC_Sts "Cruise control: Ready lights the cruise ready lamp, Active the cruise lamp and the set speed.";
CM_ SG_ 832 ADAS_CC_SetSpeed "Cruise control set speed.";
CM_ SG_ 832 ADAS_LDW_Sts "Lane departure warning: Ready lights the lane assist lamp; a warning flashes the lane warning lamp.";
CM_ SG_ 832 ADAS_LaneLeft "Left lane marking detected.";
CM_ SG_ 832 ADAS_LaneRight "Right lane marking detected.";
CM_ SG_ 832 ADAS_FCW_TtReq "Forward collision warning lamp request.";
CM_ SG_ 848 TPMS_Warn_TtReq "Tyre pressure warning lamp request.";
CM_ SG_ 912 BCM_KL15 "Ignition (terminal 15).";
CM_ SG_ 912 BCM_Immo_TtReq "Immobiliser lamp request.";
CM_ SG_ 913 BCM_HeadlampSts "Headlamps: Position lights the position lamp, LowBeam the low beam lamp.";
CM_ SG_ 913 BCM_HighBeam_TtReq "High beam lamp request.";
CM_ SG_ 913 BCM_FrontFog_TtReq "Front fog lamp request.";
CM_ SG_ 913 BCM_RearFog_TtReq "Rear fog lamp request.";
CM_ SG_ 913 BCM_TurnLeft_Ind "Left turn indicator lamp.";
CM_ SG_ 913 BCM_TurnRight_Ind "Right turn indicator lamp.";
CM_ SG_ 914 BCM_WasherLow_TtReq "Washer fluid low lamp request.";
CM_ SG_ 914 BCM_DoorFL "Front left door; any door, the boot or the bonnet open lights the door lamp.";
CM_ SG_ 915 BCM_OutsideTemp "Outside temperature.";
CM_ SG_ 960 ECM_CoolantTemp "Coolant temperature; 118 degC and over lights the coolant warning lamp.";
CM_ SG_ 960 ECM_FuelLevel "Fuel level; at 12% and under the cluster lights the low fuel lamp.";
CM_ SG_ 960 ECM_FuelRate "Fuel consumption rate, for the trip computer.";
CM_ SG_ 928 VCU_ePower "Electric drive power, recuperation negative.";
CM_ SG_ 928 VCU_SOC "Battery state of charge.";
CM_ SG_ 944 SWM_TripReset "Steering wheel trip reset button.";
CM_ SG_ 1184 MMI_Elapsed "Media track position.";

